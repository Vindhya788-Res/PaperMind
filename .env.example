# PaperMind environment configuration.
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# All variables are prefixed with PAPERMIND_.

# Deployment environment: development | testing | production
PAPERMIND_ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
PAPERMIND_LOG_LEVEL=INFO

# Directory for local data artifacts. Defaults to <project_root>/data when unset.
# PAPERMIND_DATA_DIR=

# API server bind address. Port 8001 avoids the commonly-occupied 8000 on Windows.
PAPERMIND_API_HOST=127.0.0.1
PAPERMIND_API_PORT=8001

# Reserved for future LLM / embedding integrations (leave blank until needed).
# PAPERMIND_OPENAI_API_KEY=
# PAPERMIND_ANTHROPIC_API_KEY=
